# Cabeceras de seguridad a nivel HTTP (Apache).
# Equivalente al archivo _headers de Netlify/Cloudflare. Requiere mod_headers.
# Estas cabeceras son las que de verdad protegen contra clickjacking y MIME
# sniffing: el navegador IGNORA X-Frame-Options/nosniff cuando van como <meta>.
<IfModule mod_headers.c>
  Header always set Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self' https://fonts.googleapis.com; font-src https://fonts.gstatic.com; img-src 'self' https: data:; frame-src https://www.google.com; connect-src 'self' https://api.web3forms.com; base-uri 'self'; form-action 'self' https://api.web3forms.com; frame-ancestors 'self'; object-src 'none'"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set Permissions-Policy "geolocation=(), camera=(), microphone=(), payment=(), usb=()"
  # HSTS: solo tiene efecto sobre HTTPS; el navegador lo ignora sin TLS.
  Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains"
</IfModule>
